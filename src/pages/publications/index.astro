<BaseLayout title="Publications | Liming Zheng" description="Selected publications by Liming Zheng in bio-inspired aerial robotics, morphing aircraft, autonomous perching, and flight control.">
  <span class="eyebrow">Research output</span>
  <h1>Publications</h1>
  <p class="lead">
    Journal articles, manuscripts, and conference papers on bio-inspired aerial robotics,
    morphing aircraft, autonomous perching, aerodynamics, and flight control.
  </p>

  <h2 class="publication-section-title">Journal articles & manuscripts</h2>
  <ol class="publication-list">
    {journalPublications.map((publication) => (
      <li class:list={["publication", { featured: publication.featured }]}>
        <div class="publication-year">{publication.year}</div>
        <div>
          <h2>{publication.title}</h2>
          <p class="publication-authors">{publication.authors}</p>
          <p class="publication-venue">{publication.venue}</p>
          <div class="publication-links">
            {publication.paper && <a class="text-link" href={publication.paper}>Paper →</a>}
            {publication.project && <a class="text-link" href={publication.project}>Research story →</a>}
          </div>
        </div>
      </li>
    ))}
  </ol>

  <h2 class="publication-section-title">Conference papers</h2>
  <ol class="publication-list">
    {conferencePublications.map((publication) => (
      <li class:list={["publication", { featured: publication.featured }]}>
        <div class="publication-year">{publication.year}</div>
        <div>
          <h2>{publication.title}</h2>
          <p class="publication-authors">{publication.authors}</p>
          <p class="publication-venue">{publication.venue}</p>
          {publication.paper && <a class="text-link" href={publication.paper}>Paper →</a>}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
